# Run uv run python scripts/bootstrap.py to generate local credentials safely.
# Set this to your own PostgreSQL DSN for self-hosting. Never commit .env.
E2E_DATABASE_URL=postgresql+asyncpg://e2e:CHANGE_ME@127.0.0.1:55432/e2e
E2E_BASE_URL=http://localhost:4100
E2E_COOKIE_SECURE=false
E2E_TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4100","http://127.0.0.1:4100"]
